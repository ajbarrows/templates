def create_quarto_site(target_dir, project_name, config):
    """Create a Quarto website alongside the project."""
    quarto_config = config.get("quarto", {})
    if not quarto_config.get("use_quarto", True):
        return

    template_dir = SCRIPT_DIR / "quarto-site"
    if not template_dir.exists():
        print(f"Warning: Quarto template not found at {template_dir}", file=sys.stderr)
        return

    quarto_dir = target_dir / "quarto"
    shutil.copytree(template_dir, quarto_dir)

    # Symlink quarto/figures -> ../reports/figures so generated figures are
    # accessible from all sections of the Quarto site without copying.
    (quarto_dir / "figures").symlink_to(Path("../reports/figures"))

    # Build substitution map from config
    remote = config.get("default_remote", "").rstrip("/")
    github_url = f"{remote}/{project_name}" if remote else "#"
    author = config.get("author", {}).get("name", "")
    deploy = config.get("deploy") or {}
    base_url = (deploy.get("base_url") or "").rstrip("/")
    base_path = (deploy.get("base_path") or "").rstrip("/")
    site_url = f"{base_url}/{project_name}/" if base_url else ""

    substitutions = {
        "project_name": project_name,
        "project_github_url": github_url,
        "author_name": author,
        "site_url": site_url,
    }

    # Drop the site-url line when no deploy URL is configured.
    if not site_url:
        quarto_yml = quarto_dir / "_quarto.yml"
        quarto_yml.write_text(re.sub(r"(?m)^ *site-url: site_url\n", "", quarto_yml.read_text()))

    # Apply substitutions to all .qmd and .yml files
    for path in quarto_dir.rglob("*"):
        if path.is_file() and path.suffix in {".qmd", ".yml", ".yaml", ".css"}:
            text = path.read_text()
            for token, value in substitutions.items():
                text = text.replace(token, value)
            path.write_text(text)

    # Per-project deploy settings, read by quarto/deploy
    (quarto_dir / "_deploy.conf").write_text(
        "# Read by ./deploy. Edit to change where this site is published.\n"
        f"PROJECT={project_name}\n"
        f"SSH_HOST={deploy.get('ssh_host') or ''}\n"
        f"REMOTE_DIR={base_path + '/' + project_name if base_path else ''}\n"
        f"SITE_URL={site_url}\n"
    )

    print(f"  Quarto site: quarto/  (cd quarto && quarto preview)")
    if not (deploy.get("ssh_host") and base_path):
        print("  Note: deploy settings missing from config.yaml; fill in quarto/_deploy.conf")


def setup_precommit(target_dir, lang):
    """Install pre-commit hooks and generate a secrets baseline."""
    if not (target_dir / ".pre-commit-config.yaml").exists():
        return

    print("Setting up pre-commit hooks...")
    if lang in ("python", "python-r"):
        # pre-commit and detect-secrets are dev deps; use uv run after uv sync
        result = subprocess.run(
            ["uv", "run", "pre-commit", "install"], cwd=target_dir, check=False
        )
        if result.returncode == 0:
            with (target_dir / ".secrets.baseline").open("w") as f:
                subprocess.run(
                    ["uv", "run", "detect-secrets", "scan"],
                    stdout=f, cwd=target_dir, check=False,
                )
        else:
            print("  Warning: pre-commit install failed — run 'pre-commit install' manually.")
    else:
        result = subprocess.run(["pre-commit", "install"], cwd=target_dir, check=False)
        if result.returncode != 0:
            print("  Warning: pre-commit install failed — install pre-commit and run it manually.")


def init_git(target_dir, project_name, config):
    """Initialize git repo and optionally set remote."""
    subprocess.run(["git", "init"], cwd=target_dir, check=True)

    remote = config.get("default_remote", "")
    if remote:
        remote_url = f"{remote}/{project_name}.git"
        subprocess.run(
            ["git", "remote", "add", "origin", remote_url],
            cwd=target_dir,
            check=True,
        )
        print(f"  Remote: {remote_url}")


def main():
    parser = argparse.ArgumentParser(
        description="Create a new PhD research project from a template."
    )
    parser.add_argument("name", help="Project name (e.g. my-project)")
    parser.add_argument(
        "--lang",
        required=True,
        choices=["python", "r", "python-r"],
        help="Project language: python, r, or python-r (Python primary with R support)",
    )
    parser.add_argument(
        "--dir",
        help="Target parent directory (overrides default_project_dir from config)",
    )
    parser.add_argument(
        "--no-quarto",
        action="store_true",
        help="Skip creating the Quarto website",
    )
    args = parser.parse_args()

    config = load_config()
    target_dir = resolve_target_dir(args, config)

    if target_dir.exists():
        print(f"Error: {target_dir} already exists", file=sys.stderr)
        sys.exit(1)

    print(f"Creating {args.lang} project '{args.name}' at {target_dir}")
    print()

    if args.lang == "python":
        create_python_project(target_dir, args.name, config)
    elif args.lang == "r":
        create_r_project(target_dir, args.name, config)
    elif args.lang == "python-r":
        create_python_r_project(target_dir, args.name, config)

    if not args.no_quarto:
        create_quarto_site(target_dir, args.name, config)

    # Initialize git (must come before pre-commit install)
    init_git(target_dir, args.name, config)

    # Set up pre-commit hooks
    setup_precommit(target_dir, args.lang)

    print()
    print(f"Done! Project created at {target_dir}")
    print()
    print("Next steps:")
    print("  1. Fill in data/SOURCES.md with your data classification")
    print("  2. If pre-commit setup failed: pip install pre-commit && pre-commit install")


if __name__ == "__main__":
    main()
