# .env.example — copy to .env and fill in values.
# NEVER commit .env. Reference variables via os.getenv() or config.py.

# ── Data Repository ───────────────────────────────────────────────────
# DATA_REPO_TOKEN=

# ── Cloud / Object Storage ────────────────────────────────────────────
# AWS_PROFILE=
# AWS_DEFAULT_REGION=us-east-1
# DATA_BUCKET=

# ── External APIs ─────────────────────────────────────────────────────
# OPENNEURO_TOKEN=
# XNAT_HOST=https://xnat.yourorg.edu
# XNAT_USER=
# XNAT_PASSWORD=
# REDCAP_API_TOKEN=

# ── Database ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Compute / HPC ─────────────────────────────────────────────────────
# SLURM_ACCOUNT=
# HPC_HOST=

# ── Project ───────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
